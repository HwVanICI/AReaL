+++ b/parse_reward_unified.py
@@ -0,0 +1,395 @@
+import re
+import json
+import sys
+from typing import List, Dict, Optional
+from pathlib import Path
+from datetime import datetime
+import matplotlib.pyplot as plt
+import shutil
+
+
+# -------------------------
+# Shared regex patterns
+# -------------------------
+ANSI_ESCAPE = re. compile(r'\x1b\[[0-9;]*m')
+STEP_PATTERN_EVAL = re.compile(r'Epoch\s+(\d+)/\d+\s+Step\s+(\d+)/(\d+)')
+STEP_PATTERN_TRAIN = re.compile(r'Epoch\s+(\d+)/\d+\s+Step\s+(\d+)/\d+')
+TIMESTAMP_PATTERN = re.compile(r'(\d{8}-\d{2}:\d{2}:\d{2}\.\d{3})')
+
+
+def convert_timestamp_to_seconds(timestamp: str, reference:  str = None) -> float:
+    """
+    Convert timestamp string to seconds elapsed from reference. 
+    Format: YYYYMMDD-HH:MM:SS.mmm
+    """
+    if not timestamp:
+        return None
+    
+    dt = datetime.strptime(timestamp, "%Y%m%d-%H:%M:%S.%f")
+    
+    if reference is None:
+        reference = timestamp
+    
+    ref_dt = datetime.strptime(reference, "%Y%m%d-%H:%M:%S.%f")
+    return (dt - ref_dt).total_seconds()
+
+
+def average_rewards_by_epoch(rewards: List[Dict]) -> List[Dict]:
+    """
+    Average rewards within each epoch.
+    Returns a list with one entry per epoch.
+    """
+    if not rewards:
+        return []
+    
+    epoch_data = {}
+    
+    for r in rewards:
+        epoch = r["epoch"]
+        if epoch not in epoch_data:
+            epoch_data[epoch] = []
+        epoch_data[epoch]. append(r["avg"])
+    
+    result = []
+    for epoch in sorted(epoch_data.keys()):
+        avg_reward = sum(epoch_data[epoch]) / len(epoch_data[epoch])
+        result.append({
+            "epoch": epoch,
+            "avg": avg_reward
+        })
+    
+    return result
+
+def plot_rewards(train_rewards:  List[Dict], eval_rewards:  List[Dict], output_dir:  str):
+    """
+    Plot train and eval rewards vs global_step, time, and epoch.  
+    
+    Args: 
+        train_rewards: List of dicts with keys:   avg, min, max, epoch, step, global_step, timestamp
+        eval_rewards: List of dicts with keys:  avg, min, max, epoch, step, global_step, timestamp
+        output_dir:  Directory to save plots
+    """
+    # Create output directory
+    output_path = Path(output_dir)
+    output_path.mkdir(exist_ok=True, parents=True)
+    
+    # Extract data
+    has_eval = len(eval_rewards) > 0
+    
+    # Train data
+    train_global_steps = [r["global_step"] for r in train_rewards]
+    train_avg_rewards = [r["avg"] for r in train_rewards]
+    
+    # Eval data
+    if has_eval:
+        eval_global_steps = [r["global_step"] for r in eval_rewards]
+        eval_avg_rewards = [r["avg"] for r in eval_rewards]
+    
+    # Time data (convert timestamps to seconds)
+    reference_timestamp = None
+    train_timestamps = []
+    for r in train_rewards:
+        if r["timestamp"]:
+            if reference_timestamp is None:
+                reference_timestamp = r["timestamp"]
+            train_timestamps.append(convert_timestamp_to_seconds(r["timestamp"], reference_timestamp))
+        else:
+            train_timestamps. append(None)
+    
+    eval_timestamps = []
+    if has_eval:
+        for r in eval_rewards:
+            if r["timestamp"]:
+                if reference_timestamp is None:
+                    reference_timestamp = r["timestamp"]
+                eval_timestamps.append(convert_timestamp_to_seconds(r["timestamp"], reference_timestamp))
+            else:
+                eval_timestamps.append(None)
+    
+    # Filter out None timestamps
+    train_time_data = [(t, r) for t, r in zip(train_timestamps, train_avg_rewards) if t is not None]
+    if train_time_data:
+        train_times, train_rewards_time = zip(*train_time_data)
+    else:
+        train_times, train_rewards_time = [], []
+    
+    if has_eval:
+        eval_time_data = [(t, r) for t, r in zip(eval_timestamps, eval_avg_rewards) if t is not None]
+        if eval_time_data:  
+            eval_times, eval_rewards_time = zip(*eval_time_data)
+        else:
+            eval_times, eval_rewards_time = [], []
+    
+    # ============================================================
+    # Plot 1: Reward vs Global Step
+    # ============================================================
+    plt.figure(figsize=(10, 6))
+    plt.plot(train_global_steps, train_avg_rewards, 'b-o', label='Train Reward', alpha=0.7, markersize=4)
+    if has_eval:
+        plt.plot(eval_global_steps, eval_avg_rewards, 'r-s', label='Eval Reward', alpha=0.7, markersize=4)
+    plt.xlabel('Global Step', fontsize=12)
+    plt.ylabel('Average Reward', fontsize=12)
+    plt.title('Training and Evaluation Rewards vs Global Step', fontsize=14)
+    plt.legend()
+    plt.grid(True, alpha=0.3)
+    plt.tight_layout()
+    plt.savefig(output_path / "reward_vs_global_step.png", dpi=150)
+    plt.close()
+    print(f"✓ Saved: {output_path / 'reward_vs_global_step.png'}")
+    
+    # ============================================================
+    # Plot 2: Reward vs Time
+    # ============================================================
+    if train_times:
+        plt. figure(figsize=(10, 6))
+        plt.plot(train_times, train_rewards_time, 'b-o', label='Train Reward', alpha=0.7, markersize=4)
+        if has_eval and eval_times:
+            plt. plot(eval_times, eval_rewards_time, 'r-s', label='Eval Reward', alpha=0.7, markersize=4)
+        plt.xlabel('Time (seconds)', fontsize=12)
+        plt.ylabel('Average Reward', fontsize=12)
+        plt.title('Training and Evaluation Rewards vs Time', fontsize=14)
+        plt.legend()
+        plt.grid(True, alpha=0.3)
+        plt.tight_layout()
+        plt.savefig(output_path / "reward_vs_time.png", dpi=150)
+        plt.close()
+        print(f"✓ Saved: {output_path / 'reward_vs_time.png'}")
+    else:
+        print("⚠ Skipping time plot:  No valid timestamps found")
+    
+    # ============================================================
+    # Plot 3: Reward vs Epoch (averaged per epoch)
+    # ============================================================
+    train_epoch_avg = average_rewards_by_epoch(train_rewards)
+    train_epochs = [r["epoch"] for r in train_epoch_avg]
+    train_epoch_rewards = [r["avg"] for r in train_epoch_avg]
+    
+    plt.figure(figsize=(10, 6))
+    plt.plot(train_epochs, train_epoch_rewards, 'b-o', label='Train Reward (avg per epoch)', alpha=0.7, markersize=6)
+    
+    if has_eval:
+        eval_epoch_avg = average_rewards_by_epoch(eval_rewards)
+        eval_epochs = [r["epoch"] for r in eval_epoch_avg]
+        eval_epoch_rewards = [r["avg"] for r in eval_epoch_avg]
+        plt.plot(eval_epochs, eval_epoch_rewards, 'r-s', label='Eval Reward', alpha=0.7, markersize=6)
+    
+    plt.xlabel('Epoch', fontsize=12)
+    plt.ylabel('Average Reward', fontsize=12)
+    plt.title('Training and Evaluation Rewards vs Epoch', fontsize=14)
+    plt.legend()
+    plt.grid(True, alpha=0.3)
+    plt.tight_layout()
+    plt.savefig(output_path / "reward_vs_epoch.png", dpi=150)
+    plt.close()
+    print(f"✓ Saved:  {output_path / 'reward_vs_epoch.png'}")
+
+def parse_eval_rewards(log_file: str):
+    """
+    Parse eval-rollout/reward metrics.
+    Output fields:
+      avg, min, max, epoch, step, global_step, timestamp
+    """
+    metric_pattern = re.compile(
+        r'eval-rollout/reward\s*[│|:  ]\s*([-\d. e+]+)'
+    )
+
+    results = []
+    current_step = None
+    current_timestamp = None
+
+    global_step = 0
+    last_epoch = 0
+    steps_per_epoch = None
+
+    with open(log_file, "r", encoding="utf-8", errors="ignore") as f:
+        for line in f:
+            clean_line = ANSI_ESCAPE.sub("", line)
+
+            # Timestamp
+            ts_match = TIMESTAMP_PATTERN.search(clean_line)
+            if ts_match:
+                current_timestamp = ts_match. group(1)
+
+            # Step info
+            step_match = STEP_PATTERN_EVAL. search(clean_line)
+            if step_match:
+                epoch, step, total_steps = map(int, step_match.groups())
+
+                if epoch != last_epoch:  
+                    if steps_per_epoch is None:
+                        steps_per_epoch = total_steps
+                    last_epoch = epoch
+
+                global_step = (epoch - 1) * steps_per_epoch + step
+
+                current_step = {
+                    "epoch": epoch,
+                    "step": step,
+                    "global_step": global_step,
+                }
+
+            # Reward metric → flush immediately with timestamp
+            reward_match = metric_pattern.search(clean_line)
+            if reward_match and current_step:
+                reward = float(reward_match.group(1))
+                results.append({
+                    "avg": reward,
+                    "min": reward,
+                    "max": reward,
+                    **current_step,
+                    "timestamp": current_timestamp,
+                })
+
+    return results
+
+
+def parse_train_rewards(log_file: str) -> List[Dict]:
+    """
+    Parse GRPO task rewards.
+    Output fields:
+      avg, min, max, epoch, step, global_step, timestamp
+    """
+    metric_pattern = re.compile(
+        r'ppo_actor/task_reward/(avg|min|max)\s*[│|: ]\s*([-\d.e+]+)'
+    )
+
+    results = []
+    current_entry = {}
+    current_step = None
+    current_timestamp = None
+
+    last_epoch = 0
+    steps_per_epoch:  Optional[int] = None
+
+    with open(log_file, "r", encoding="utf-8", errors="ignore") as f:
+        for line in f:
+            clean_line = ANSI_ESCAPE.sub("", line)
+
+            # Timestamp
+            ts_match = TIMESTAMP_PATTERN.search(clean_line)
+            if ts_match:
+                current_timestamp = ts_match. group(1)
+
+            # Step / epoch
+            step_match = STEP_PATTERN_TRAIN.search(clean_line)
+            if step_match:
+                epoch, step = map(int, step_match.groups())
+
+                # Detect steps_per_epoch when transitioning to epoch 2
+                if epoch == 2 and last_epoch == 1 and steps_per_epoch is None:
+                    # The previous step was the last step of epoch 1
+                    if results:
+                        steps_per_epoch = results[-1]["step"]
+                
+                # Calculate global_step
+                if steps_per_epoch is not None:
+                    global_step = (epoch - 1) * steps_per_epoch + step
+                else:
+                    # Before we know steps_per_epoch, use step as global_step
+                    global_step = step
+
+                last_epoch = epoch
+
+                current_step = {
+                    "epoch": epoch,
+                    "step": step,
+                    "global_step": global_step,
+                }
+
+            # Metrics
+            matches = metric_pattern.findall(clean_line)
+            for kind, value in matches:
+                current_entry[kind] = float(value)
+
+            # End of stats block
+            if "╘" in clean_line and current_entry:
+                if current_step:
+                    current_entry. update(current_step)
+                current_entry["timestamp"] = current_timestamp
+                results.append(current_entry)
+                current_entry = {}
+
+    # Post-process: fix global_step if we learned steps_per_epoch later
+    if steps_per_epoch is not None:  
+        for entry in results:
+            entry["global_step"] = (entry["epoch"] - 1) * steps_per_epoch + entry["step"]
+
+    return results
+
+
+def save_rewards_to_json(train_rewards: List[Dict], eval_rewards: List[Dict], log_file: str, output_dir: str):
+    """
+    Save train and eval rewards to JSON files.
+    
+    Args:
+        train_rewards: List of dicts with train reward data
+        eval_rewards: List of dicts with eval reward data
+        output_dir:  Directory to save JSON files
+    """
+    output_path = Path(output_dir)
+    output_path.mkdir(exist_ok=True, parents=True)
+    
+    shutil.copy(log_file, output_dir)    
+    
+    # Save train rewards
+    train_file = output_path / "train_rewards.json"
+    with open(train_file, 'w', encoding='utf-8') as f:
+        json.dump(train_rewards, f, indent=2)
+    print(f"✓ Saved: {train_file} ({len(train_rewards)} entries)")
+    
+    # Save eval rewards
+    eval_file = output_path / "eval_rewards.json"
+    with open(eval_file, 'w', encoding='utf-8') as f:
+        json.dump(eval_rewards, f, indent=2)
+    print(f"✓ Saved: {eval_file} ({len(eval_rewards)} entries)")
+
+
+def extract_base_name(log_file: str) -> str:
+    """
+    Extract base name from log file. 
+    simar_XX. log -> simar_XX
+    """
+    path = Path(log_file)
+    # Remove . log extension
+    name = path.stem
+    return name
+
+
+if __name__ == "__main__": 
+    # Get log file from command line argument or use default
+    if len(sys.argv) > 1:
+        log_file = sys.argv[1]
+    else:
+        print("Usage: python parse_reward_unified.py <log_file>")
+        print("Example: python parse_reward_unified.py simar_xccl.log")
+        sys.exit(1)
+    
+    # Verify file exists
+    if not Path(log_file).exists():
+        print(f"Error: File '{log_file}' not found!")
+        sys.exit(1)
+    
+    # Extract base name for output directory
+    base_name = extract_base_name(log_file)
+    output_dir = f"./{base_name}"
+    
+    print(f"Processing log file: {log_file}")
+    print(f"Output directory:  {output_dir}\n")
+    
+    print("Parsing train rewards...")
+    train_rewards = parse_train_rewards(log_file)
+    print(f"Found {len(train_rewards)} train reward entries")
+    
+    print("Parsing eval rewards...")
+    eval_rewards = parse_eval_rewards(log_file)
+    print(f"Found {len(eval_rewards)} eval reward entries\n")
+    
+    print("Saving JSON data...")
+    save_rewards_to_json(train_rewards, eval_rewards, log_file, output_dir=output_dir)
+    
+    print("\nGenerating plots...")
+    plot_rewards(train_rewards, eval_rewards, output_dir=output_dir)
+    
+    print("\n✓ All files generated successfully!")
+    
+    
