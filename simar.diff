+++ b/create_dummy.py
@@ -0,0 +1,161 @@
+import argparse
+import json
+from pathlib import Path
+
+import torch
+from transformers import AutoConfig, AutoModelForCausalLM, AutoTokenizer
+
+
+def _set_num_hidden_layers(config, num_hidden_layers: int) -> None:
+    """
+    Try to reduce decoder layer count for smoke-test checkpoints.
+
+    Different model repos nest the text/LM config differently; this helper
+    handles common patterns (top-level, text_config, language_config, llm_config).
+    """
+    # Top-level
+    if hasattr(config, "num_hidden_layers"):
+        config.num_hidden_layers = min(num_hidden_layers, int(config.num_hidden_layers))
+
+    # Common nested configs
+    for attr in ("text_config", "language_config", "llm_config"):
+        sub = getattr(config, attr, None)
+        if sub is not None and hasattr(sub, "num_hidden_layers"):
+            sub.num_hidden_layers = min(num_hidden_layers, int(sub.num_hidden_layers))
+
+
+def _get_saved_num_hidden_layers(saved_config) -> int:
+    for obj in (
+        getattr(saved_config, "text_config", None),
+        getattr(saved_config, "language_config", None),
+        getattr(saved_config, "llm_config", None),
+        saved_config,
+    ):
+        if obj is not None and hasattr(obj, "num_hidden_layers"):
+            return int(getattr(obj, "num_hidden_layers"))
+    raise AttributeError("Could not find num_hidden_layers in saved config.")
+
+
+def _summarize_saved_checkpoint(output_dir: Path) -> dict[str, object]:
+    index_path = output_dir / "model.safetensors.index.json"
+    summary = {
+        "has_index": index_path.exists(),
+        "weight_files": [],
+    }
+    if index_path.exists():
+        with index_path.open() as handle:
+            index = json.load(handle)
+        summary["weight_files"] = sorted(set(index.get("weight_map", {}).values()))
+    else:
+        summary["weight_files"] = sorted(p.name for p in output_dir.glob("*.safetensors"))
+    return summary
+
+def build_dummy_checkpoint(
+    source_model: str,
+    output_dir: str,
+    num_hidden_layers: int,
+    dtype: str,
+    max_shard_size: str,
+) -> None:
+    output_path = Path(output_dir)
+    output_path.mkdir(parents=True, exist_ok=True)
+
+    torch_dtype = getattr(torch, dtype)
+    config = AutoConfig.from_pretrained(source_model, trust_remote_code=True)
+    _set_num_hidden_layers(config, num_hidden_layers)
+
+    model = AutoModelForCausalLM.from_pretrained(
+        source_model,
+        config=config,
+        torch_dtype=torch_dtype,
+        trust_remote_code=True,
+        low_cpu_mem_usage=True,
+    )
+    model.save_pretrained(
+        output_path,
+        safe_serialization=True,
+        max_shard_size=max_shard_size,
+    )
+
+    # ✅ Copy ALL tokenizer files to preserve everything
+    import shutil
+    source_path = Path(source_model)
+    tokenizer_files = [
+        "tokenizer.json",
+        "tokenizer_config.json", 
+        "special_tokens_map.json",
+        "vocab.json",
+        "merges.txt",
+        "added_tokens.json",
+    ]
+    
+    for filename in tokenizer_files:
+        src_file = source_path / filename
+        if src_file.exists():
+            shutil.copy2(src_file, output_path / filename)
+    
+    # Also use AutoTokenizer to ensure it works
+    tokenizer = AutoTokenizer.from_pretrained(source_model, trust_remote_code=True)
+    tokenizer.save_pretrained(output_path)
+
+    saved_config = AutoConfig.from_pretrained(output_path, trust_remote_code=True)
+    saved_layers = _get_saved_num_hidden_layers(saved_config)
+    summary = _summarize_saved_checkpoint(output_path)
+    print(
+        json.dumps(
+            {
+                "source_model": source_model,
+                "output_dir": str(output_path),
+                "num_hidden_layers": saved_layers,
+                "dtype": dtype,
+                **summary,
+            },
+            indent=2,
+        )
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Create a reduced-layer GLM-4.5 AIR checkpoint for smoke tests."
+    )
+    parser.add_argument(
+        "--source-model",
+        default="/data/efs/models/Qwen3-235B-A22B",
+        help="Path to the source Hugging Face checkpoint (GLM-4.5 AIR).",
+    )
+    parser.add_argument(
+        "--output-dir",
+        default="/data/efs/models/Qwen3-235B-A22B-Dummy4Layer",
+        help="Directory where the reduced checkpoint will be written.",
+    )
+    parser.add_argument(
+        "--num-hidden-layers",
+        type=int,
+        default=4,
+        help="Number of decoder layers to keep in the dummy checkpoint.",
+    )
+    parser.add_argument(
+        "--dtype",
+        default="bfloat16",
+        choices=["float16", "bfloat16", "float32"],
+        help="dtype used when materializing the checkpoint before saving.",
+    )
+    parser.add_argument(
+        "--max-shard-size",
+        default="5GB",
+        help="Maximum shard size passed to save_pretrained.",
+    )
+    args = parser.parse_args()
+
+    build_dummy_checkpoint(
+        source_model=args.source_model,
+        output_dir=args.output_dir,
+        num_hidden_layers=args.num_hidden_layers,
+        dtype=args.dtype,
+        max_shard_size=args.max_shard_size,
+    )
+
+
+if __name__ == "__main__":
+    main()
