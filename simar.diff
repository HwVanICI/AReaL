+CONTAINER_NAME=AReaL_simar
+CURRENT_HOSTNAME=$(python3 -c "import socket; print(socket.gethostname())")
+CURRENT_IP=$(python3 -c "import socket; print(socket.gethostbyname(socket.gethostname()))")
+docker run \
+--privileged \
+--cap-add=SYS_PTRACE \
+--device=/dev/davinci0 \
+--device=/dev/davinci1 \
+--device=/dev/davinci2 \
+--device=/dev/davinci3 \
+--device=/dev/davinci4 \
+--device=/dev/davinci5 \
+--device=/dev/davinci6 \
+--device=/dev/davinci7 \
+--device=/dev/davinci8 \
+--device=/dev/davinci9 \
+--device=/dev/davinci10 \
+--device=/dev/davinci11 \
+--device=/dev/davinci12 \
+--device=/dev/davinci13 \
+--device=/dev/davinci14 \
+--device=/dev/davinci15 \
+--device=/dev/davinci_manager \
+--device=/dev/devmm_svm \
+--device=/dev/hisi_hdc \
+--shm-size=2048g \
+--net=host \
+--name ${CONTAINER_NAME} \
+--hostname ${CURRENT_HOSTNAME} \
+--add-host $CURRENT_HOSTNAME:$CURRENT_IP \
+-v /usr/local/dcmi:/usr/local/dcmi \
+-v /usr/local/Ascend/driver:/usr/local/Ascend/driver \
+-v /etc/ascend_install.info:/etc/ascend_install.info \
+-v /var/log/npu/:/usr/slog \
+-v /usr/local/sbin/npu-smi:/usr/local/sbin/npu-smi \
+-v /sys/fs/cgroup:/sys/fs/cgroup:ro \
+-v /home/model:/home/model \
+-v /home/tim:/home/tim \
+-v /home/simar:/home/simar \
+-v /home/geshi:/home/geshi \
+-v /efs_rl:/efs_rl \
+-v /data:/data \
+-v /nfs:/nfs \
+-v /usr/local/Ascend/driver/tools/hccn_tool:/usr/local/Ascend/driver/tools/hccn_tool \
+-v /usr/local/bin/npu-smi:/usr/local/bin/npu-smi \
+-v /usr/local/Ascend/driver/lib64/:/usr/local/Ascend/driver/lib64/ \
+-v /usr/local/Ascend/driver/version.info:/usr/local/Ascend/driver/version.info \
+-v /root/.cache:/root/.cache \
+-e no_proxy=127.0.0.1,localhost,7.150.10.228,7.150.15.242,7.150.14.236,7.150.10.22,7.150.12.254,7.150.8.112,7.150.11.220,7.150.8.255,7.150.9.97,7.150.10.28,7.150.15.115,7.150.12.40,7.150.13.70,7.150.11.40,7.150.11.163,7.150.14.15,7.150.14.151,mirrors.tools.huawei.com,mirrors.myhuaweicloud.com,.huawei.com \
+-e NO_PROXY=127.0.0.1,localhost,7.150.10.228,7.150.15.242,7.150.14.236,7.150.10.22,7.150.12.254,7.150.8.112,7.150.11.220,7.150.8.255,7.150.9.97,7.150.10.28,7.150.15.115,7.150.12.40,7.150.13.70,7.150.11.40,7.150.11.163,7.150.14.15,mirrors.tools.huawei.com,mirrors.myhuaweicloud.com,.huawei.com \
+-e GIT_SSL_NO_VERIFY=1 \
+-u root \
+-itd ${IMAGE} /bin/bash
+```
+
+### Code Setup
+
+```bash
+git clone ssh://git@rnd-gitlab-ca-g.huawei.com:2222/EI/arealite-npu.git
+git checkout LoraMegatronMoEClean
+
+# Install Areal and mindspeed from above links
+pip3 install mbridge
+
+cd patch/vllm/vllm-enginecore-ext/ 
+pip install -e .
+cd ../../..
+```
+
+
+## Running
+
+```bash
+clear && python examples/math/gsm8k_rl.py --config /data/efs/simar/arealite-npu/examples/math/gsm8k_grpo_megatron_merged_lora_qwen_8b_sn.yaml   2>&1 | tee out.log
+```
+
+Note that, base models are used as finetuned models performance is already very good.
+
+### Qwen3-30B Base Single Node
+```
+clear && python examples/math/gsm8k_rl.py --config examples/math/gsm8k_grpo_megatron_lora_30b_sn.yaml  2>&1 | tee out.log
+
+```
+
+<img src="lora-results/qwen3-30b-sn.png" width="45%" /> <img src="lora-results/qwen3-30b-eval-sn.png" width="45%" />
+
+
+
+
+
+### Qwen3-30B Base Multi Node
+```
+clear && python examples/math/gsm8k_rl.py --config examples/math/gsm8k_grpo_megatron_lora_30b_mn.yaml  2>&1 | tee out.log
+
+```
+
+
+<img src="lora-results/qwen3-30b-mn.png" width="45%" /> <img src="lora-results/qwen3-30b-eval-mn.png" width="45%" />
