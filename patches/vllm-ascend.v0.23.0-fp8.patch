+            target_scale = layer.weight_scale.data
+            layer.weight_scale.data = inference_scale
+            layer.weight_scale.data.copy_(target_scale)
+            del layer._mxfp8_rl_inference_weight_ptr
+            del layer._mxfp8_rl_inference_scale
+
         # Mark as transformed
         layer._mxfp8_transformed = True
 
@@ -175,6 +193,14 @@ class AscendW8A8MXFP8DynamicLinearMethod(AscendLinearScheme):
         orig_shapes = layer._mxfp8_original_shapes
