@@ -141,6 +141,24 @@ class AscendW8A8MXFP8DynamicLinearMethod(AscendLinearScheme):
         layer.weight.data = layer.weight.data.transpose(0, 1).contiguous()
         layer.weight_scale.data = layer.weight_scale.data.transpose(0, 1).contiguous()
 
+        inference_scale = getattr(layer, "_mxfp8_rl_inference_scale", None)
+        if inference_scale is not None:
+            if layer.weight.data_ptr() != layer._mxfp8_rl_inference_weight_ptr:
+                raise RuntimeError(
+                    "[vllm-ascend/W8A8_MXFP8] Reloading changed the inference "
